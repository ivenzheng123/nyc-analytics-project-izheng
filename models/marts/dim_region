-- models/work/marts/core/dim_region.sql

WITH all_regions AS (

    SELECT DISTINCT borough
    FROM {{ ref('stg_nyc_311_dot') }}

    UNION DISTINCT

    SELECT DISTINCT borough
    FROM {{ ref('stg_shooting_combined') }}

),

final AS (
    SELECT
        {{ dbt_utils.generate_surrogate_key(['borough']) }} AS region_key,
        borough
    FROM all_regions
)

SELECT * FROM final